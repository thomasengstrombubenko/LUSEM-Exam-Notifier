# Public iCalendar feed containing exam events (required)
ICS_URL=https://example.com/exams.ics

# Listmonk API connection and campaign sender (required)
LISTMONK_URL=https://listmonk.example.com
LISTMONK_USERNAME=your-listmonk-username
LISTMONK_PASSWORD=your-listmonk-password
SENDER_EMAIL=exams@example.com

# Links included in reminder emails
LADOK_URL=https://www.student.ladok.se/
GITHUB_URL=https://github.com/your-name/your-repository

# Optional healthchecks.io ping URL; leave empty to disable
HEALTHCHECK_URL=

# Optional; defaults to Europe/Stockholm
TIMEZONE=Europe/Stockholm

# Optional Python logging level; defaults to INFO
LOG_LEVEL=INFO
